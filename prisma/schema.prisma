generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js v5 required models ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash        String?
  emailUnsubscribed   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  watchlist       WatchlistItem[]
  ratings         Rating[]
  tasteProfile    TasteProfile?
  favoritePersons FavoritePerson[]
  hostedRooms     PartnerRoom[] @relation("HostRooms")
  guestRooms      PartnerRoom[] @relation("GuestRooms")
  watchLogs       WatchLog[]
  achievements    UserAchievement[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Kinopolka domain models ──────────────────────────────────────────────────

model WatchlistItem {
  id          String    @id @default(cuid())
  userId      String
  tmdbId      Int
  mediaType   String    // "movie" | "tv"
  title       String
  posterPath  String?
  addedAt     DateTime  @default(now())
  watchedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId])
  @@map("watchlist_items")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  mediaType String   // "movie" | "tv"
  score     Int      // 1–5
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId])
  @@map("ratings")
}

// Partner Mode — комната для совместного подбора фильмов
model PartnerRoom {
  id            String   @id @default(cuid())
  code          String   @unique
  hostId        String
  guestId       String?
  status        String   @default("waiting") // "waiting" | "active" | "done"
  hostGenreIds  Int[]
  guestGenreIds Int[]
  resultIds     Int[]    // TMDB movie IDs from intersection
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  host  User  @relation("HostRooms", fields: [hostId], references: [id], onDelete: Cascade)
  guest User? @relation("GuestRooms", fields: [guestId], references: [id], onDelete: SetNull)

  @@index([hostId])
  @@map("partner_rooms")
}

// Favorite Person — выбранные актёры/режиссёры на шаге 2 онбординга
model FavoritePerson {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  name        String
  role        String   // "actor" | "director"
  profilePath String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
  @@map("favorite_persons")
}

// Shared Result — публичный шеринг результатов квиза
model SharedResult {
  id        String   @id @default(cuid())
  movieIds  Int[]
  mediaType String   @default("movie")
  params    Json
  createdAt DateTime @default(now())

  @@map("shared_results")
}

// Watch Log — дневник просмотров (каждый просмотр = запись)
model WatchLog {
  id         String   @id @default(cuid())
  userId     String
  tmdbId     Int
  mediaType  String   // "movie" | "tv"
  title      String
  posterPath String?
  watchedAt  DateTime @default(now())
  note       String?
  isRewatch  Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType, watchedAt])
  @@index([userId, watchedAt(sort: Desc)])
  @@map("watch_logs")
}

// User Achievement — разблокированные достижения / badges
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  badge      String   // 'first_watch' | 'cinephile_10' | 'genre_master' | 'explorer' | 'partner'
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId])
  @@map("user_achievements")
}

// Password Reset Token — одноразовый токен сброса пароля
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// Taste Profile — результат Onboarding (выбранные постеры → жанры)
model TasteProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  genreIds     Int[]    // выбранные genre_id из TMDB
  movieIds     Int[]    // tmdbId постеров, которые выбрал пользователь
  completedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taste_profiles")
}
